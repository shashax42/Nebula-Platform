# Terraform 파일
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# 민감한 변수 파일 (절대 커밋 금지!)
*.tfvars
*.tfvars.json

# Override 파일
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI 설정
.terraformrc
terraform.rc

# Plan 파일 (실행 계획 포함)
*.tfplan
*tfplan*

# Lock 파일 (팀마다 정책 다름, 일단 제외)
.terraform.lock.hcl

# 백엔드 설정 파일 (민감정보 포함 가능)
*.hcl

# AWS 자격증명 (절대 커밋 금지!)
.aws/
credentials
*.pem
*.key

# 환경변수 파일
.env
.env.*
.envrc

# 시크릿 파일
secrets/
*.secret
password*
*credentials*

# 배치 스크립트 (자격증명 포함 가능)
*.bat

# Kubernetes Secrets
**/kubernetes-manifests/**/secret*.yaml
**/kubernetes-manifests/**/*secret*.yaml

# IDE 설정
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
.project
.settings/

# OS 파일
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
ehthumbs.db

# 로그 파일
*.log
logs/
*.log.*

# 백업 및 임시 파일
*.backup
*.bak
*.tmp
*.old
*~

# 테스트 디렉토리
temp/
tmp/
test/
testing/
