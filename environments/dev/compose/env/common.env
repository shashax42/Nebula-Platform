# Terraform services.tf 의 common_env + 로컬 전용 값
PROFILE=kubernetes
SPRING_JPA_HIBERNATE_DDL_AUTO=update
DB_POOL_SIZE=10
NEBULA_ENVIRONMENT=local
# Nebula-Monitoring/tools/local-stack 의 agent (먼저 띄워 두면 트레이스·메트릭이 그쪽 Prometheus/Grafana 로 간다)
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# 클러스터 밖에는 Kubernetes Service(80 → 8080)와 Spring Cloud Kubernetes 디스커버리가 없다 → 정적 인스턴스로 대신한다
SPRING_APPLICATION_JSON={"spring":{"cloud":{"discovery":{"client":{"simple":{"instances":{"service-account":[{"uri":"http://service-account:8080"}],"service-order":[{"uri":"http://service-order:8080"}],"service-product":[{"uri":"http://service-product:8080"}]}}}}}}}
