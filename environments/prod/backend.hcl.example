# cp backend.hcl.example backend.hcl  (backend.hcl 은 .gitignore 대상)
bucket         = "<shared/terraform-backend 로 만든 state 버킷>"
key            = "env/prod/terraform.tfstate"   # Nebula-Monitoring 의 target_state_key 와 같은 경로
region         = "ap-northeast-2"
dynamodb_table = "<state lock 테이블>"
encrypt        = true
