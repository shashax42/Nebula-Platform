# cp terraform.tfvars.example terraform.tfvars  (*.tfvars 는 .gitignore 대상)
region = "ap-northeast-2"

# 운영자 IP 로 좁히는 것을 권장
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

# nebula-gitops 가 private 이면 읽기 토큰
gitops_token = ""

# Nebula-Monitoring apply + render-gitops-values.sh prod 후 true
enable_aws_platform_apps = false

# HTTPS 를 쓰려면 ACM 인증서
ingress_certificate_arn = ""

auth0 = {
  domain        = ""
  client_id     = ""
  client_secret = ""
}
